# Gerado pelo deploy/setup.sh a partir deste modelo (__DOMAIN__ vira o domínio do .env).
global:
  scrape_interval: 10s
  evaluation_interval: 10s

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets: ['127.0.0.1:19090']

  - job_name: vps
    static_configs:
      - targets: ['127.0.0.1:19100']

  - job_name: containers
    scrape_interval: 15s
    scrape_timeout: 12s
    static_configs:
      - targets: ['127.0.0.1:19323']

  - job_name: concord
    static_configs:
      - targets: ['127.0.0.1:9464']

  - job_name: caddy
    static_configs:
      - targets: ['127.0.0.1:2019']

  # o cloudflared (serviço da VPS) publica métricas na primeira porta livre entre 20241 e 20245
  - job_name: cloudflared
    static_configs:
      - targets: ['127.0.0.1:20241', '127.0.0.1:20242', '127.0.0.1:20243', '127.0.0.1:20244', '127.0.0.1:20245']

  - job_name: http
    metrics_path: /probe
    params:
      module: [http_2xx]
    static_configs:
      - targets: ['https://__DOMAIN__/health']
        labels: { probe: 'site (de fora, pela Cloudflare)' }
      - targets: ['http://127.0.0.1:3000/health']
        labels: { probe: 'app (por dentro)' }
      - targets: ['http://127.0.0.1:7880']
        labels: { probe: 'LiveKit (voz e vídeo)' }
    relabel_configs: &probe
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: 127.0.0.1:19115

  - job_name: ping
    metrics_path: /probe
    params:
      module: [icmp]
    static_configs:
      - targets: ['1.1.1.1']
        labels: { probe: 'Cloudflare (1.1.1.1)' }
      - targets: ['8.8.8.8']
        labels: { probe: 'Google (8.8.8.8)' }
    relabel_configs: *probe
