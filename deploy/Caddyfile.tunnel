# Modo túnel (cloudflared): a Cloudflare cuida do HTTPS; o Caddy só roteia localmente.
{
	auto_https off
	# métricas para o monitoramento (lidas pelo Prometheus em 127.0.0.1:2019)
	metrics
	# quem chega aqui é o cloudflared, na própria máquina: o IP de verdade vem no X-Forwarded-For dele
	# (o servidor do Concord usa o IP nos limites de login e cadastro)
	servers {
		trusted_proxies static 127.0.0.1/32 ::1/128
	}
}

:8090 {
	bind 127.0.0.1

	# Sinalização do LiveKit no mesmo domínio: wss://DOMINIO/livekit
	handle_path /livekit/* {
		reverse_proxy 127.0.0.1:7880
	}

	# compressão (o modelo de supressão de ruído cai de 16 MB para ~4 MB)
	encode zstd gzip

	# Monitoramento (Grafana, com login)
	handle /grafana* {
		reverse_proxy 127.0.0.1:13001
	}

	handle {
		reverse_proxy 127.0.0.1:3000
	}
}
