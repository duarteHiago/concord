{
  "name": "concord-desktop",
  "productName": "Concord",
  "version": "1.0.0",
  "description": "Concord para desktop: transmissão de tela a 60 fps com áudio sem retorno",
  "author": "duarteHiago",
  "license": "MIT",
  "main": "main.cjs",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:all": "electron-builder --win --mac --publish never"
  },
  "dependencies": {
    "electron-updater": "6.8.10"
  },
  "devDependencies": {
    "electron": "44.9.0",
    "electron-builder": "26.17.0"
  },
  "build": {
    "appId": "com.duartehiago.concord",
    "productName": "Concord",
    "files": ["main.cjs", "preload.cjs", "offline.html", "update-signature.cjs", "update-key.pub", "build/icon.png", "build/icon.ico"],
    "directories": { "output": "release" },
    "publish": [{ "provider": "generic", "url": "https://concord-community.com/downloads/" }],
    "win": {
      "target": ["nsis"],
      "icon": "build/icon.ico",
      "artifactName": "Concord-Setup-${version}.${ext}",
      "extraResources": [
        { "from": "native/audio-capture.exe", "to": "audio-capture.exe" },
        { "from": "native/window-shake.exe", "to": "window-shake.exe" }
      ]
    },
    "mac": {
      "target": ["dmg", "zip"],
      "icon": "build/icon.png",
      "category": "public.app-category.social-networking",
      "artifactName": "Concord-${version}.${ext}"
    },
    "dmg": {
      "title": "Concord",
      "iconSize": 100,
      "contents": [
        { "x": 130, "y": 220 },
        { "x": 410, "y": 220, "type": "link", "path": "/Applications" }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Concord",
      "include": "build/installer.nsh"
    }
  }
}
